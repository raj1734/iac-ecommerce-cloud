aws_region = "ap-south-1"
environment = "dev"
project_name = "ecommerce-platform"
az_count = 2
deploy_services = true
enable_waf = true
ecs_desired_count = 1

# Terraform-only secret values.
# Put real values in an uncommitted local tfvars file.
db_master_password       = "CHANGE_ME_TO_A_STRONG_16+_CHAR_SECRET"
redis_password            = "CHANGE_ME_TO_A_STRONG_16+_CHAR_SECRET"
jwt_secret                = "CHANGE_ME_TO_A_LONG_RANDOM_32+_CHAR_SECRET"
config_password           = "CHANGE_ME_TO_A_STRONG_CONFIG_PASSWORD"
bootstrap_admin_password  = "CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD"

# Non-secret bootstrap/config values can remain here.
db_master_username       = "ecommerceadmin"
config_username           = "admin"
bootstrap_admin_username  = "admin"
bootstrap_admin_email     = "admin@example.com"
