aws_region = "ap-south-1"
environment = "dev"
project_name = "ecommerce-platform"
az_count = 2
deploy_services = true
enable_msk = true
enable_waf = true
ecs_desired_count = 1
# Set via TF_VAR_db_master_password or an uncommitted tfvars file.
db_master_password = "CHANGE_ME_TO_A_STRONG_16+_CHAR_SECRET"
